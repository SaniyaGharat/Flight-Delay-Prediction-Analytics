{
  "python.defaultInterpreterPath": "~/flight-delay-analytics/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": [
    "${workspaceFolder}/src"
  ],
  "python.analysis.autoSearchPaths": true,
  "terminal.integrated.env.linux": {
    "PYTHONPATH": "${workspaceFolder}",
    "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64",
    "HADOOP_HOME": "/home/saniya/hadoop",
    "PATH": "/home/saniya/hadoop/bin:/home/saniya/hadoop/sbin:${env:PATH}"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/metastore_db": true,
    "**/spark-warehouse": true
  }
}
